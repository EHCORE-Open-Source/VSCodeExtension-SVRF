{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Calibre SVRF",
    "scopeName": "source.calibre.svrf.basic",
    "patterns": [
        {
            "include": "#comment"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numeric"
        },
        {
            "include": "#preprocess"
        },
        {
            "include": "#layer_operation"
        },
        {
            "include": "#layer_operation_complex_keywords"
        },
        {
            "include": "#layer_operation_basic_keywords"
        },
        {
            "include": "#keywords"
        }
    ],
    "repository": {
        "comment": {
            "patterns": [
                {
                    "comment": "block comment",
                    "name": "comment.block.calibre.svrf.basic",
                    "begin": "/\\*",
                    "end": "\\*/",
                    "patterns": [
                        {
                            "match": "\\b(TODO)\\b",
                            "name": "markup.bold.calibre.svrf.basic"
                        }
                    ]
                },
                {
                    "comment": "line comment",
                    "name": "comment.block.calibre.svrf.basic",
                    "match": "//(.*)",
                    "captures": {
                        "1": {
                            "patterns": [
                                {
                                    "match": "\\b(TODO)\\b",
                                    "name": "markup.bold.calibre.svrf.basic"
                                }
                            ]
                        }
                    }
                },
                {
                    "comment": "rule check comment",
                    "name": "comment.block.calibre.svrf.basic",
                    "match": "@(.*)",
                    "captures": {
                        "1": {
                            "patterns": [
                                {
                                    "match": "\\s(\\x5E[[:word:]]+)\\b",
                                    "name": "variable.other.constant.calibre.svrf.ruleCheck strong.calibre.svrf.ruleCheck"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        "preprocess": {
            "patterns": [
                {
                    "comment": "preprocess directives (define)",
                    "match": "(#(?i:(?:un)?define))(?:\\s+([[:alpha:]_][[:word:]$]*))?\\b",
                    "captures": {
                        "1": {
                            "name": "variable.other.calibre.svrf.preprocess"
                        },
                        "2": {
                            "name": "variable.other.constant.calibre.svrf.preprocess"
                        }
                    }
                },
                {
                    "comment": "preprocess directives (if-else)",
                    "match": "(?:#(?i:ifn?def|else|endif))\\b",
                    "name": "variable.other.calibre.svrf.preprocess"
                },
                {
                    "comment": "preprocess directives (pragma)",
                    "match": "(?i:#pragma)\\b",
                    "name": "variable.other.calibre.svrf.preprocess"
                }
            ]
        },
        "layer_operation": {
            "patterns": [
                {
                    "comment": "layer operation equation",
                    "match": "([[:word:]]*)\\s*(=)",
                    "captures": {
                        "1": {
                            "name": "variable.other.calibre.svrf.basic"
                        },
                        "2": {
                            "name": "punctuation.definition.tag.calibre.svrf.equation"
                        }
                    }
                }
            ]
        },
        "layer_operation_complex_keywords": {
            "patterns": [
                {
                    "comment": "complex layer operation (Prefix NOT)",
                    "name": "keyword.control.calibre.svrf.basic markup.underline.calibre.svrf.basic",
                    "match": "\\b(?i:(not\\s+(?:angle|area|cut|donut|enclose(?:\\s+rectangle)?|inside\\s+cell|(?:in|out)(?:side)?(?:\\s+edge)?|interact|length|net|rectangle|touch(?:\\s+(?:in|out)(?:side)?)?\\s+edge|touch|with\\s+(?:edge|neighbor|text|width))))\\b"
                },
                {
                    "comment": "complex layer operation (Prefix A-D)",
                    "name": "keyword.control.calibre.svrf.basic markup.underline.calibre.svrf.basic",
                    "match": "\\b(?i:((?:not\\s+)?coin(?:cident)?(?:\\s+(?:in|out)(?:side)?)?\\s+edge|convex\\s+edge|density\\s+convolve|device\\s+layer|drawn\\s+(?:acute|angled|offgrid|skew)))\\b"
                },
                {
                    "comment": "complex layer operation (Prefix E-I)",
                    "name": "keyword.control.calibre.svrf.basic markup.underline.calibre.svrf.basic",
                    "match": "\\b(?i:(enclose\\s+rectangle|expand\\s+(?:edge|text)|extent\\s+(?:cell|drawn)|inductance\\s+micheck|(?:in|out)(?:side)?\\s+edge|inside\\s+cell))\\b"
                },
                {
                    "comment": "complex layer operation (Prefix N-P)",
                    "name": "keyword.control.calibre.svrf.basic markup.underline.calibre.svrf.basic",
                    "match": "\\b(?i:(net\\s+area(?:\\s+ratio(?:\\s+(?:accumulate|coupled|print))?)?|offgrid\\s+directional|or\\s+edge|parasitic\\s+variation|path\\s+length))\\b"
                },
                {
                    "comment": "complex layer operation (Prefix R)",
                    "name": "keyword.control.calibre.svrf.basic markup.underline.calibre.svrf.basic",
                    "match": "\\b(?i:(rectangle\\s+enclosure))\\b"
                }
            ]
        },
        "layer_operation_basic_keywords": {
            "patterns": [
                {
                    "comment": "layer operation (Prefix A-I)",
                    "name": "keyword.control.calibre.svrf.basic",
                    "match": "\\b(?i:(and|(?:de)?angle|area|copy|cut|density|donut|enclose|enc(?:losure)?|extents?|ext(?:ernal)?|flatten|grow|holes|(?:in|out)(?:side)?|interact|int(?:ernal)?))\\b"
                },
                {
                    "comment": "layer operation (Prefix L-S)",
                    "name": "keyword.control.calibre.svrf.basic",
                    "match": "\\b(?i:(length|magnify|merge|net|interact|not|offgrid|or(?:net)?|pathchk|perimeter|pins|ports|push|rectangles?|rotate|shift|shrink|size|snap|stamp))\\b"
                },
                {
                    "comment": "layer operation (Prefix T)",
                    "name": "keyword.control.calibre.svrf.basic",
                    "match": "\\b(?i:(tddrc|topex|touch|))\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "comment": "Prefix A",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(abut|acute|and|angled?|area|attach))\\b"
                },
                {
                    "comment": "Prefix B",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(by))\\b"
                },
                {
                    "comment": "Prefix C",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(capacitance|coin(?:cident)?|connect(?:ed)?|convex|copy|corner|cut))\\b"
                },
                {
                    "comment": "Prefix D",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(dbclassify|deangle|density|dev(?:ice)?|dfm|direct|disconnect|donut|drawn|drc))\\b"
                },
                {
                    "comment": "Prefix E",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(enc(?:los(?:ur)?e)?|erc|ex(?:clude|pand|t(?:en(?:d|ts?)|ernal)?)))\\b"
                },
                {
                    "comment": "Prefix F",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(flag|flatten|fracture|fringe))\\b"
                },
                {
                    "comment": "Prefix G",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(group|grow))\\b"
                },
                {
                    "comment": "Prefix H",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(hcell|holes))\\b"
                },
                {
                    "comment": "Prefix I",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(in(?:ductance|side|t(?:er(?:act|nal|secting))?)?))\\b"
                },
                {
                    "comment": "Prefix L",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(label|lay(?:er|out)|length|litho|lvs))\\b"
                },
                {
                    "comment": "Prefix M",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(magnify|mask|measure|merge))\\b"
                },
                {
                    "comment": "Prefix N",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(net|not(?:ch)?))\\b"
                },
                {
                    "comment": "Prefix O",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(obtuse|offgrid|opc(?:bias|lineend|sbar)|opposite|or(?:net)?|out(?:side)?|overlap))\\b"
                },
                {
                    "comment": "Prefix P",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(para(?:llel|sitic)?|path|per(?:imeter|[cp]|pendicular)|pex|pins|polygon|ports?|precision|proj(?:ecting)?|push))\\b"
                },
                {
                    "comment": "Prefix R",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(rectangles?|region|resistance|resolution|ret|rotate))\\b"
                },
                {
                    "comment": "Prefix S",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(sbar|sconnect|shift|shrink|singular|size|snap|source|sraf_fill|space|square|stamp|step|svrf))\\b"
                },
                {
                    "comment": "Prefix T",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(tddrc|text|title|topex|touch|trace|tvf))\\b"
                },
                {
                    "comment": "Prefix U",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(unit))\\b"
                },
                {
                    "comment": "Prefix V",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(variable|vertex|virtual))\\b"
                },
                {
                    "comment": "Prefix W",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(with))\\b"
                },
                {
                    "comment": "Prefix X",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(xor))\\b"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.calibre.svrf.basic",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.calibre.svrf.basic",
                    "match": "\\\\."
                }
            ]
        },
        "numeric": {
            "patterns": [
                {
                    "comment": "numeric for scientific or symbol notation",
                    "name": "constant.numeric.calibre.svrf.basic",
                    "match": "(?:\\b|[+-])[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b"
                }
            ]
        }
    }
}