{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Calibre SVRF",
    "scopeName": "source.calibre.svrf.basic",
    "patterns": [
        {
            "include": "#comment"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numeric"
        },
        {
            "include": "#preprocess"
        },
        {
            "include": "#mathematics"
        },
        {
            "include": "#variable"
        },
        {
            "include": "#layer_operation"
        },
        {
            "include": "#layer_operation_complex_keywords"
        },
        {
            "include": "#layer_operation_basic_keywords"
        },
        {
            "include": "#layer_definition"
        },
        {
            "include": "#keywords"
        }
    ],
    "repository": {
        "comment": {
            "patterns": [
                {
                    "comment": "block comment",
                    "name": "comment.block.calibre.svrf.basic",
                    "begin": "/\\*",
                    "end": "\\*/",
                    "patterns": [
                        {
                            "match": "\\b(TODO)\\b",
                            "name": "markup.bold.calibre.svrf.basic"
                        }
                    ]
                },
                {
                    "comment": "line comment",
                    "name": "comment.block.calibre.svrf.basic",
                    "match": "//(.*)",
                    "captures": {
                        "1": {
                            "patterns": [
                                {
                                    "match": "\\b(TODO)\\b",
                                    "name": "markup.bold.calibre.svrf.basic"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.calibre.svrf.basic",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.calibre.svrf.basic",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.calibre.svrf.basic",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.calibre.svrf.basic",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "comment": "rule check comment",
                    "name": "string.unquoted.rulecheck.calibre.svrf.comment",
                    "match": "@(.*)",
                    "captures": {
                        "1": {
                            "patterns": [
                                {
                                    "match": "\\s(\\x5E[[:word:]]+)\\b",
                                    "name": "variable.other.constant.calibre.svrf.ruleCheck strong.calibre.svrf.ruleCheck"
                                }
                            ]
                        }
                    }
                }
            ]
            
        },
        "numeric": {
            "patterns": [
                {
                    "comment": "numeric for scientific or symbol notation",
                    "name": "constant.numeric.calibre.svrf.basic",
                    "match": "(?:\\b|[+-])[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b"
                }
            ]
        },
        "preprocess": {
            "patterns": [
                {
                    "comment": "preprocess directives (define)",
                    "match": "(#(?i:(?:(?:un)?define|ifn?def)))(?:\\s+([[:alpha:]_][[:word:]$]*))?\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.calibre.svrf.preprocess strong.calibre.svrf.preprocess"
                        },
                        "2": {
                            "name": "variable.name.constant.calibre.svrf.preprocess"
                        }
                    }
                },
                {
                    "comment": "preprocess directives (if-else)",
                    "match": "(#(?i:else|endif))\\b",
                    "name": "keyword.control.calibre.svrf.preprocess strong.calibre.svrf.preprocess"
                },
                {
                    "comment": "preprocess directives (pragma)",
                    "match": "(?i:#pragma)\\b",
                    "name": "keyword.control.calibre.svrf.preprocess strong.calibre.svrf.preprocess"
                }
            ]
        },
        "variable": {
            "comment": "variable declare",
            "match": "^\\s*(?i:(variable)(?:\\s+([[:alpha:]_][[:word:]$]*))?)\\b",
            "captures": {
                "1": {
                    "name": "keyword.other.calibre.svrf.variable"
                },
                "2": {
                    "name": "variable.name.calibre.svrf.basic"
                }
            }
        },
        "layer_operation": {
            "comment": "layer operation equation",
            "match": "([[:word:]]+)\\s*(=)",
            "captures": {
                "1": {
                    "name": "variable.other.calibre.svrf.basic"
                },
                "2": {
                    "name": "punctuation.definition.tag.calibre.svrf.equation"
                }
            }
        },
        "layer_operation_complex_keywords": {
            "patterns": [
                {
                    "comment": "complex layer operation (Keyword DFM Prefix A-D)",
                    "name": "keyword.control.calibre.svrf.basic markup.underline.calibre.svrf.basic",
                    "match": "\\b(?i:(dfm\\s+(?:analyze|caf|circle\\s+(?:a(?:nalyze)?|generate)|classify|cog|contour|copy|create\\s+layer\\s+polygons|critical\\s+area|density|direction|dv(?:\\s+(?:analyze|interact|override))?)))\\b"
                },
                {
                    "comment": "complex layer operation (Keyword DFM Prefix E-P)",
                    "name": "keyword.control.calibre.svrf.basic markup.underline.calibre.svrf.basic",
                    "match": "\\b(?i:(dfm\\s+(?:empty|expand\\s+(?:edge|enclosure)|fill|gca|grow|histogram|jogclean|measure|merge|narac|optimize|or(?:\\s+edge)?|partition|pattern\\s+(?:analyze|capture|classify|cluster|export|filter|import|))))\\b"
                },
                {
                    "comment": "complex layer operation (Keyword DFM Prefix P-R)",
                    "name": "keyword.control.calibre.svrf.basic markup.underline.calibre.svrf.basic",
                    "match": "\\b(?i:(dfm\\s+(?:property(?:\\s+merge|net|select\\s+secondary|singleton)?|puzzle\\s+analyze|rdb(?:\\s+ascii|def|gds|oasis)?|read|rectangles|(?:non\\s+)?redundant\\s+vias|redundant\\s+vias\\s+count|remove\\s+edge)))\\b"
                },
                {
                    "comment": "complex layer operation (Keyword DFM Prefix S-W)",
                    "name": "keyword.control.calibre.svrf.basic markup.underline.calibre.svrf.basic",
                    "match": "\\b(?i:(dfm\\s+(?:segment|select\\s+by\\s+net|shift(?:\\s+edge)?|size|softchk|space|stadium\\s+analyze|stamp|stripe|text|transform|transition|wrap)))\\b"
                },
                {
                    "comment": "complex layer operation (Keyword NOT? COIN or TOUCH)",
                    "name": "keyword.control.calibre.svrf.basic markup.underline.calibre.svrf.basic",
                    "match": "\\b(?i:((?:not\\s+)?(?:(?:coin(?:cident)?|touch)(?:\\s+(?:in|out)(?:side)?)?\\s+edge|with\\s+(?:edge|neighbor|text|width))))\\b"
                },
                {
                    "comment": "complex layer operation (Keyword NOT)",
                    "name": "keyword.control.calibre.svrf.basic markup.underline.calibre.svrf.basic",
                    "match": "\\b(?i:(not\\s+(?:angle|area|cut|donut|enclose(?:\\s+rectangle)?|inside\\s+cell|(?:in|out)(?:side)?(?:\\s+edge)?|interact|length|net|rectangle|touch)))\\b"
                },
                {
                    "comment": "complex layer operation (Prefix A-D)",
                    "name": "keyword.control.calibre.svrf.basic markup.underline.calibre.svrf.basic",
                    "match": "\\b(?i:(convex\\s+edge|density\\s+convolve|device\\s+layer|drawn\\s+(?:acute|angled|offgrid|skew)))\\b"
                },
                {
                    "comment": "complex layer operation (Prefix E-I)",
                    "name": "keyword.control.calibre.svrf.basic markup.underline.calibre.svrf.basic",
                    "match": "\\b(?i:(enclose\\s+rectangle|expand\\s+(?:edge|text)|extent\\s+(?:cell|drawn)|inductance\\s+micheck|(?:in|out)(?:side)?\\s+edge|inside\\s+cell))\\b"
                },
                {
                    "comment": "complex layer operation (Prefix N-P)",
                    "name": "keyword.control.calibre.svrf.basic markup.underline.calibre.svrf.basic",
                    "match": "\\b(?i:(net\\s+area(?:\\s+ratio(?:\\s+(?:accumulate|coupled|print))?)?|offgrid\\s+directional|or\\s+edge|parasitic\\s+variation|path\\s+length))\\b"
                },
                {
                    "comment": "complex layer operation (Prefix R-W)",
                    "name": "keyword.control.calibre.svrf.basic markup.underline.calibre.svrf.basic",
                    "match": "\\b(?i:(rectangle\\s+enclosure))\\b"
                }
            ]
        },
        "layer_operation_basic_keywords": {
            "patterns": [
                {
                    "comment": "layer operation (Prefix A-I)",
                    "name": "keyword.control.calibre.svrf.basic",
                    "match": "\\b(?i:(and|(?:de)?angle|area|copy|cut|density|donut|enclose|enc(?:losure)?|extents?|ext(?:ernal)?|flatten|grow|holes|(?:in|out)(?:side)?|interact|int(?:ernal)?))\\b"
                },
                {
                    "comment": "layer operation (Prefix L-S)",
                    "name": "keyword.control.calibre.svrf.basic",
                    "match": "\\b(?i:(length|magnify|merge|net|interact|not|offgrid|or(?:net)?|pathchk|perimeter|pins|ports|push|rectangles?|rotate|shift|shrink|size|snap|stamp))\\b"
                },
                {
                    "comment": "layer operation (Prefix T-X)",
                    "name": "keyword.control.calibre.svrf.basic",
                    "match": "\\b(?i:(tddrc|topex|touch|vertex|xor))\\b"
                }
            ]
        },
        "layer_definition": {
            "patterns": [
                {
                    "comment": "layer map",
                    "match": "^\\s*(?i:(layer)(?:\\s+(map(\\s+[[:digit:]]+(\\s+datatype(\\s+[[:digit:]]+)?)?)?)))",
                    "captures": {
                        "1": {
                            "name": "keyword.other.calibre.svrf.layer"
                        },
                        "2": {
                            "name": "keyword.other.calibre.svrf.layer markup.underline.calibre.svrf.layermap"
                        },
                        "3": {
                            "name": "markup.underline.calibre.svrf.layermap",
                            "patterns": [
                                {
                                    "include": "#numeric"
                                },
                                {
                                    "comment": "layer datatype",
                                    "match": "((?i:datatype))",
                                    "name": "keyword.other.calibre.svrf.layer"
                                }
                            ]
                        }
                    }
                },
                {
                    "comment": "layer definition",
                    "match": "^\\s*((?i:layer))(?:\\s+([[:alpha:]_][[:word:]$]*))?",
                    "captures": {
                        "1": {
                            "name": "keyword.other.calibre.svrf.layer"
                        },
                        "2": {
                            "name": "variable.name.calibre.svrf.layer"
                        }
                    }
                }
            ]
        },
        "mathematics": {
            "patterns": [
                {
                    "begin": "\\b(?i:(ceil|floor|trunc|sqrt|abs|exp|log|sin|cos|tan|min|max))\\(",
                    "beginCaptures": {
                        "1": {
                            "name": "entity.name.function.calibre.svrf.math strong.calibre.svrf.math"
                        }
                    },
                    "end": "\\)",
                    "patterns": [
                        {
                            "include": "#comment"
                        },
                        {
                            "include": "#strings"
                        },
                        {
                            "include": "#numeric"
                        },
                        {
                            "include": "#preprocess"
                        },
                        {
                            "include": "#mathematics"
                        }
                    ]
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "comment": "Prefix A",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(abut|acute|and|angled?|area|attach))\\b"
                },
                {
                    "comment": "Prefix B",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(by))\\b"
                },
                {
                    "comment": "Prefix C",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(capacitance|coin(?:cident)?|connect(?:ed)?|convex|copy|corner|cut))\\b"
                },
                {
                    "comment": "Prefix D",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(dbclassify|deangle|density|dev(?:ice)?|dfm|direct|disconnect|donut|drawn|drc))\\b"
                },
                {
                    "comment": "Prefix E",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(enc(?:los(?:ur)?e)?|erc|ex(?:clude|pand|t(?:en(?:d|ts?)|ernal)?)))\\b"
                },
                {
                    "comment": "Prefix F",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(flag|flatten|fracture|fringe))\\b"
                },
                {
                    "comment": "Prefix G",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(group|grow))\\b"
                },
                {
                    "comment": "Prefix H",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(hcell|holes))\\b"
                },
                {
                    "comment": "Prefix I",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(in(?:ductance|side|t(?:er(?:act|nal|secting))?)?))\\b"
                },
                {
                    "comment": "Prefix L",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(label|lay(?:er|out)|length|litho|lvs))\\b"
                },
                {
                    "comment": "Prefix M",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(magnify|mask|measure|merge))\\b"
                },
                {
                    "comment": "Prefix N",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(net|not(?:ch)?))\\b"
                },
                {
                    "comment": "Prefix O",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(obtuse|offgrid|opc(?:bias|lineend|sbar)|opposite|or(?:net)?|out(?:side)?|overlap))\\b"
                },
                {
                    "comment": "Prefix P",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(para(?:llel|sitic)?|path|per(?:imeter|[cp]|pendicular)|pex|pins|polygon|ports?|precision|proj(?:ecting)?|push))\\b"
                },
                {
                    "comment": "Prefix R",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(rectangles?|region|resistance|resolution|ret|rotate))\\b"
                },
                {
                    "comment": "Prefix S",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(sbar|sconnect|shift|shrink|singular|size|snap|source|sraf_fill|space|square|stamp|step|svrf))\\b"
                },
                {
                    "comment": "Prefix T",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(tddrc|text|title|topex|touch|trace|tvf))\\b"
                },
                {
                    "comment": "Prefix U",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(unit))\\b"
                },
                {
                    "comment": "Prefix V",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(variable|vertex|virtual))\\b"
                },
                {
                    "comment": "Prefix W",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(with))\\b"
                },
                {
                    "comment": "Prefix X",
                    "name": "keyword.other.calibre.svrf.basic",
                    "match": "\\b(?i:(xor))\\b"
                }
            ]
        }
    }
}