{
    "comments": {
        "lineComment": "//",
        "blockComment": [ "/*", "*/" ]
    },
    "brackets": [
        [ "{", "}" ],
        [ "[", "]" ],
        [ "(", ")" ],
        [ "#ifdef", "#endif" ]
    ],
    "autoClosingPairs": [
        { "open": "(", "close": ")", "notIn": [ "comment", "string" ] },
        { "open": "[", "close": "]", "notIn": [ "comment", "string" ] },
        { "open": "{", "close": "}", "notIn": [ "comment", "string" ] },
        { "open": "\"", "close": "\"", "notIn": [ "comment", "string" ] },
        { "open": "'", "close": "'", "notIn": [ "comment", "string" ] }
    ],
    "surroundingPairs": [
        [ "{", "}" ],
        [ "[", "]" ],
        [ "(", ")" ],
        [ "\"", "\"" ],
        [ "'", "'" ]
    ],
    "colorizedBracketPairs": [
        [ "{", "}" ],
        [ "[", "]" ],
        [ "(", ")" ]
    ]
}